<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distributed outside the Mac App Store; unsandboxed so received files can
	     go to ~/Pictures, ~/Downloads or any folder the user chooses. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Not enforced without the sandbox, but file_picker refuses to open its
	     dialogs unless one of the user-selected entitlements is present. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
